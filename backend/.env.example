# FinPilot Bharat v1 MVP — backend env template.
# Copy to backend/.env (or export) for local runs. All mocked, no network.
API_PORT=8000

# SQLite file used by backend/app/db.py (DATABASE_URL wins if both set).
DB_PATH=backend/data/finpilot.db
DATABASE_URL=sqlite:///./backend/data/finpilot.db

TENANT_ID=demo

# Deterministic policy thresholds (must match backend/app/config.py defaults).
AUTO_POST_CONFIDENCE=0.90
QUICK_CONFIRM_THRESHOLD=0.60
MAX_AUTO_POST_AMOUNT=10000
HIGH_VALUE_THRESHOLD=100000
